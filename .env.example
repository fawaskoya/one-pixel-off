# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Keep false until AdSense approval, owner review, privacy copy, and CMP are live.
NEXT_PUBLIC_ADS_ENABLED=false

# Server-only value used to produce /ads.txt after approval (format: pub-123...).
ADSENSE_PUBLISHER_ID=

# Future analytics must remain disabled until the consent path is implemented.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Required before public launch; use a monitored mailbox on the final domain.
NEXT_PUBLIC_CONTACT_EMAIL=
