# Public canonical origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search Console HTML-tag token only (the content value, not the full meta tag).
GOOGLE_SITE_VERIFICATION=

# Keep false until AdSense approval, owner review, privacy copy, and CMP are live.
NEXT_PUBLIC_ADS_ENABLED=false

# Public account identifier used for AdSense ownership metadata and /ads.txt.
# Setting it does not load ads or enable ad requests (format: pub-123...).
ADSENSE_PUBLISHER_ID=

# Future analytics must remain disabled until the consent path is implemented.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Required before public launch; use a monitored mailbox on the final domain.
NEXT_PUBLIC_CONTACT_EMAIL=
